<?xml version="1.0" ?>
<robot name="parrot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- === Includes: use your package (change if merging elsewhere) === -->
  <xacro:include filename="$(find thermal_detection)/urdf_drone/common_properties.urdf.xacro"/>
  <xacro:include filename="$(find thermal_detection)/urdf_drone/parrot.gazebo.xacro"/>

  <!-- === Asset root so mesh paths are easy to switch ===
       If you want to keep meshes in 41068_ignition_bringup, set:
       asset_root = '$(find 41068_ignition_bringup)/urdf_drone'
  -->
  <xacro:property name="asset_root" value="$(find thermal_detection)/urdf_drone"/>

  <!-- Camera placement helpers (same as both versions) -->
  <xacro:property name="r200_cam_rgb_px" value="0.005"/>
  <xacro:property name="r200_cam_rgb_py" value="0.018"/>
  <xacro:property name="r200_cam_rgb_pz" value="0.013"/>
  <xacro:property name="r200_cam_depth_offset" value="0.01"/>

  <!-- =============== Base hull =============== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.503"/>
      <inertia
        ixx="1.805e-3" ixy="-8.619e-7" ixz="1.555e-5"
        iyy="1.764e-3" iyz="3.595e-7"
        izz="3.328e-3"/>
    </inertial>

    <!-- (Optional) simple collision box, keep commented unless you need it
    <collision name="collision">
      <origin xyz="-0.00424 0.00014 -0.00595" rpy="0 0 0"/>
      <geometry><box size="0.5 0.5 0.2"/></geometry>
    </collision>
    -->

    <visual name="hull">
      <geometry><mesh filename="file://${asset_root}/meshes/hull.dae"/></geometry>
    </visual>
    <visual name="propeller_rr">
      <origin xyz="-0.09035 -0.11423 -0.00501"/>
      <geometry><mesh filename="file://${asset_root}/meshes/propeller_rr.dae"/></geometry>
    </visual>
    <visual name="propeller_rl">
      <origin xyz="0.09035 0.11452 -0.00501"/>
      <geometry><mesh filename="file://${asset_root}/meshes/propeller_rl.dae"/></geometry>
    </visual>
    <visual name="propeller_fr">
      <origin xyz="0.08456 -0.11435 -0.00501"/>
      <geometry><mesh filename="file://${asset_root}/meshes/propeller_fr.dae"/></geometry>
    </visual>
    <visual name="propeller_fl">
      <origin xyz="0.08456 0.11463 -0.00501"/>
      <geometry><mesh filename="file://${asset_root}/meshes/propeller_fl.dae"/></geometry>
    </visual>
  </link>

  <!-- =============== IMU =============== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0 0.068"/>
  </joint>
  <link name="imu_link"/>

  <!-- =============== Lidar puck (viz) =============== -->
  <joint name="scan_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="base_scan"/>
    <origin xyz="0 0 0.2"/>
  </joint>
  <link name="base_scan">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder length="0.04" radius="0.09"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial>
      <mass value="0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- =============== Camera mast =============== -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="0.25 0.0 0.25" rpy="0 0.785398 0"/>
    <parent link="base_link"/>
    <child  link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><box size="0.02 0.08 0.05"/></geometry>
      <material name="dark"/>
    </visual>
    <visual>
      <origin xyz="0.015 0 0" rpy="0 1.57 0"/>
      <geometry><cylinder length="0.03" radius="0.02"/></geometry>
      <material name="dark"/>
    </visual>
  </link>

  <!-- =============== RGB frames =============== -->
  <joint name="camera_rgb_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py} ${r200_cam_rgb_pz}"/>
    <parent link="camera_link"/>
    <child  link="camera_rgb_frame"/>
  </joint>
  <link name="camera_rgb_frame"/>

  <joint name="camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_rgb_frame"/>
    <child  link="camera_rgb_optical_frame"/>
  </joint>
  <link name="camera_rgb_optical_frame"/>

  <!-- =============== Depth frames =============== -->
  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="${r200_cam_rgb_px} ${r200_cam_rgb_py + r200_cam_depth_offset} ${r200_cam_rgb_pz}"/>
    <parent link="camera_link"/>
    <child  link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_depth_frame"/>
    <child  link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

  <!-- =============== Add Gazebo sensors + thermal cam =============== -->
  <xacro:parrot_gz_extensions/>

</robot>
